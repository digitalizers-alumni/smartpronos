{
  "name": "smartprono-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Tests Cypress end-to-end pour SmartProno (US-QA-001 à 009) — TypeScript.",
  "scripts": {
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run",
    "test:smoke": "cypress run --spec 'US_QA_001.cy.ts,US_QA_006.cy.ts'",
    "test:full": "cypress run --spec 'US_QA_00[1-8].cy.ts'",
    "test:nightly": "cypress run --browser chrome && cypress run --browser firefox && cypress run --browser edge",
    "test:demo": "cypress run --spec 'US_QA_009.cy.ts' --browser chrome",
    "test:perf": "cypress run --spec 'US_QA_008.cy.ts'",
    "test:resilience": "cypress run --spec 'US_QA_007.cy.ts'",
    "test:us001": "cypress run --spec 'US_QA_001.cy.ts'",
    "test:us002": "cypress run --spec 'US_QA_002.cy.ts'",
    "test:us003": "cypress run --spec 'US_QA_003.cy.ts'",
    "test:us004": "cypress run --spec 'US_QA_004.cy.ts'",
    "test:us005": "cypress run --spec 'US_QA_005.cy.ts'",
    "test:us006": "cypress run --spec 'US_QA_006.cy.ts'",
    "test:us007": "cypress run --spec 'US_QA_007.cy.ts'",
    "test:us008": "cypress run --spec 'US_QA_008.cy.ts'",
    "test:us009": "cypress run --spec 'US_QA_009.cy.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "cypress": "^13.15.0",
    "typescript": "~5.9.2",
    "wait-on": "^7.2.0"
  }
}
